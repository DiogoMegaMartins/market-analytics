# Copy to .env in the repository root. Development values only; replace before shared use.
POSTGRES_DB=market_analytics
POSTGRES_USER=market
POSTGRES_PASSWORD=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
SECRET_KEY=replace-with-64-hex-characters-generated-by-openssl-rand-hex-32
APP_ENV=development
SEC_USER_AGENT=MarketAnalytics contact@example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_PORT=8000
FRONTEND_PORT=3000
# Optional; required to scrape /metrics in staging/production.
METRICS_TOKEN=

# Optional AI Research Copilot (disabled unless explicitly enabled)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=2500
